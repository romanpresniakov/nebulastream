CREATE SINK stationEmbeddings(event_idx UINT64 NOT NULL, station_slot UINT64 NOT NULL,
    e1 FLOAT32 NOT NULL, e4 FLOAT32 NOT NULL, e5 FLOAT32 NOT NULL, embeddingSum FLOAT32 NOT NULL) TYPE File;
CREATE SINK prediction(event_idx UINT64 NOT NULL, magnitude FLOAT32 NOT NULL,
    latitude FLOAT64 NOT NULL, longitude FLOAT64 NOT NULL, depth_km FLOAT64 NOT NULL) TYPE File;

# Every station encodes its own window: three embedding values that are non-zero at all stations and the sum of all 500.
SELECT event_idx, station_slot, e1, e4, e5,
    e0 + e1 + e2 + e3 + e4 + e5 + e6 + e7 + e8 + e9 + e10 + e11 + e12 + e13 + e14 + e15 + e16 + e17 + e18 + e19 + e20 +
