# name: operator/aggregation/TensorAgg.test
# description: TENSOR_AGG writes every tuple's values into a fixed-shape float32 tensor at the position its index fields select
# groups: [Aggregation, WindowOperators]

# TENSOR_AGG(v_1, ..., v_k AT (i_1, ..., i_m) SHAPE (d_1, ..., d_m, k) DEFAULT x) returns d_1 * ... * d_m * k float32
# values, row-major, as VARSIZED bytes. The expected payloads below are Base64 of little-endian float32; the comment
# above each query lists the decoded values.
# A single VARSIZED value field holds a whole row of float32 values instead (e.g. a model's output tensor). SHAPE then
# has to list the row width as its last axis, and every row must have exactly row width * 4 bytes.

GlobalConfiguration worker.query_engine.number_of_worker_threads: [1, 4]

# A 2 x 3 grid whose cells arrive in shuffled order and with unrelated timestamps.
CREATE LOGICAL SOURCE cells(row UINT64 NOT NULL, col UINT64 NOT NULL, v FLOAT32 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR cells TYPE File;
ATTACH INLINE
1,2,6.0,7
0,0,1.0,3
1,0,4.0,1
0,2,3.0,9
0,1,2.0,5
1,1,5.0,2

# Two value fields per position, of different numeric types; both are converted to float32.
CREATE LOGICAL SOURCE pairs(i UINT64 NOT NULL, x INT32 NOT NULL, y FLOAT64 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR pairs TYPE File;
ATTACH INLINE
2,5,6.0,1
0,1,2.0,2
1,3,4.0,3

# Tuples that do not land in the tensor: an index outside the shape, a negative index, a NULL index. A NULL value
# leaves its cell at the default.
CREATE LOGICAL SOURCE edges(i INT32, v FLOAT32, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR edges TYPE File;
ATTACH INLINE
0,1.5,1
3,9.0,2
-1,9.0,3
,9.0,4
2,,5
1,2.5,6

# One logical source fed by two physical sources; every key (id) gets its own tensor, built from both sources.
CREATE LOGICAL SOURCE stations(id UINT64 NOT NULL, i UINT64 NOT NULL, v FLOAT32 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH INLINE
1,0,1.0,1
2,1,20.0,2
1,2,3.0,3

CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH INLINE
2,0,10.0,1
1,1,2.0,2
2,2,30.0,3

# Two stations recording at the same time, as a sensor network delivers them: sample by sample, with real timestamps.
CREATE LOGICAL SOURCE readings(station UINT64 NOT NULL, sample UINT64 NOT NULL, v FLOAT32 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR readings TYPE File;
ATTACH INLINE
0,0,1.0,0
1,0,4.0,0
0,1,2.0,10
1,1,5.0,10
0,2,3.0,20
1,2,6.0,20

# One value per second for six seconds; position i holds the value i + 1.
CREATE LOGICAL SOURCE timeline(i UINT64 NOT NULL, v FLOAT32 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR timeline TYPE File;
ATTACH INLINE
0,1.0,0
1,2.0,1000
2,3.0,2000
3,4.0,3000
4,5.0,4000
5,6.0,5000

# Two tuples per position. Position 0: the later timestamp (5) arrives first. Position 1: equal timestamps.
CREATE LOGICAL SOURCE duplicates(i UINT64 NOT NULL, v FLOAT32 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR duplicates TYPE File;
ATTACH INLINE
0,1.0,5
0,2.0,3
1,3.0,4
1,4.0,4

# One position written by two sources, each leaving a different value NULL.
CREATE LOGICAL SOURCE partialRows(i UINT64 NOT NULL, x FLOAT32, y FLOAT32, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR partialRows TYPE File;
ATTACH INLINE
0,1.0,,5

CREATE PHYSICAL SOURCE FOR partialRows TYPE File;
ATTACH INLINE
0,,2.0,3

# Rows of two float32 values as Base64, in shuffled order: [5, 6] at 2, [1, 2] at 0, [3, 4] at 1.
CREATE LOGICAL SOURCE rowBlobs(i UINT64 NOT NULL, r VARSIZED NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR rowBlobs TYPE File;
ATTACH INLINE
2,AACgQAAAwEA=,1
0,AACAPwAAAEA=,3
1,AABAQAAAgEA=,2

# Rows of a 2 x 2 grid of two-value cells: [1, 2], [3, 4], [5, 6], [7, 8].
CREATE LOGICAL SOURCE gridBlobs(station UINT64 NOT NULL, slot UINT64 NOT NULL, r VARSIZED NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR gridBlobs TYPE File;
ATTACH INLINE
1,1,AADgQAAAAEE=,1
0,1,AABAQAAAgEA=,2
1,0,AACgQAAAwEA=,3
0,0,AACAPwAAAEA=,4

# Rows of two keys spread over two physical sources: id 1 is [1, 2], [3, 4] and id 2 is [10, 20], [30, 40].
CREATE LOGICAL SOURCE stationBlobs(id UINT64 NOT NULL, i UINT64 NOT NULL, r VARSIZED NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stationBlobs TYPE File;
ATTACH INLINE
1,0,AACAPwAAAEA=,1
2,1,AADwQQAAIEI=,2

CREATE PHYSICAL SOURCE FOR stationBlobs TYPE File;
ATTACH INLINE
2,0,AAAgQQAAoEE=,1
1,1,AABAQAAAgEA=,2

# Two rows per position. Position 0: [1, 2] at the later timestamp (5) arrives before [7, 8]. Position 1: [3, 4] and
# [5, 6] at equal timestamps.
CREATE LOGICAL SOURCE duplicateBlobs(i UINT64 NOT NULL, r VARSIZED NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR duplicateBlobs TYPE File;
ATTACH INLINE
0,AACAPwAAAEA=,5
0,AADgQAAAAEE=,3
1,AABAQAAAgEA=,4
1,AACgQAAAwEA=,4

# TENSOR_AGG copies the bytes of a VARSIZED row as they are, so 8 ASCII characters are a row of two float32 values.
# The NULL row at position 0 is later than "AAAABBBB"; position 1 is never written.
CREATE LOGICAL SOURCE textRows(i UINT64 NOT NULL, r VARSIZED, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR textRows TYPE File;
ATTACH INLINE
0,AAAABBBB,1
0,,2
2,CCCCDDDD,3

# Six rows of 500 float32 values (row i holds i * 1000 + j at column j) in shuffled order, so the entries span several
# pages. wide_tensor.csv holds the expected 8 x 500 tensor as Base64, with rows 6 and 7 at the default 0.
CREATE LOGICAL SOURCE wideRows(i UINT64 NOT NULL, r VARSIZED NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR wideRows TYPE File;
ATTACH FILE small/tensor_agg/wide_rows.csv

CREATE LOGICAL SOURCE wideTensor(tensor VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR wideTensor TYPE File;
ATTACH FILE small/tensor_agg/wide_tensor.csv

CREATE SINK tensorSink(tensor VARSIZED NOT NULL) TYPE File;
CREATE SINK windowedTensorSink(start UINT64 NOT NULL, end UINT64 NOT NULL, tensor VARSIZED NOT NULL) TYPE File;
CREATE SINK keyedTensorSink(id UINT64 NOT NULL, tensor VARSIZED NOT NULL) TYPE File;
CREATE SINK bytesSink(bytes UINT64 NOT NULL) TYPE File;

# [[1, 2, 3], [4, 5, 6]]: every value lands at (row, col), independent of arrival order and timestamps.
SELECT TO_BASE64(TENSOR_AGG(v AT (row, col) SHAPE (2, 3))) AS tensor
FROM cells
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AACAPwAAAEAAAEBAAACAQAAAoEAAAMBA

# Only (0, 1) and (1, 2) are written; every other cell keeps the default: [[-1, 2, -1], [-1, -1, 6]].
SELECT TO_BASE64(TENSOR_AGG(v AT (row, col) SHAPE (2, 3) DEFAULT -1)) AS tensor
FROM cells
WHERE (row = UINT64(0) AND col = UINT64(1)) OR (row = UINT64(1) AND col = UINT64(2))
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AACAvwAAAEAAAIC/AACAvwAAgL8AAMBA

# The size is fixed by SHAPE, so a window with a single tuple still yields 2 * 3 values of 4 bytes.
SELECT OCTET_LENGTH(TENSOR_AGG(v AT (row, col) SHAPE (2, 3))) AS bytes
FROM cells
WHERE row = UINT64(1) AND col = UINT64(1)
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO bytesSink;
----
24

# x and y form the last axis: [[1, 2], [3, 4], [5, 6]].
SELECT TO_BASE64(TENSOR_AGG(x, y AT (i) SHAPE (3, 2))) AS tensor
FROM pairs
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AACAPwAAAEAAAEBAAACAQAAAoEAAAMBA

# [1.5, 2.5, 0]: indices 3, -1 and NULL are ignored, and the NULL value at index 2 leaves the default. With one value
# field, SHAPE may leave out the value axis.
SELECT TO_BASE64(TENSOR_AGG(v AT (i) SHAPE (3))) AS tensor
FROM edges
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AADAPwAAIEAAAAAA

# Each key's tensor combines tuples from both physical sources: id 1 is [1, 2, 3], id 2 is [10, 20, 30].
SELECT id, TO_BASE64(TENSOR_AGG(v AT (i) SHAPE (3))) AS tensor
FROM stations
GROUP BY id
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO keyedTensorSink;
----
1,AACAPwAAAEAAAEBA
2,AAAgQQAAoEEAAPBB

# ARRAY_AGG orders by arrival and time, so the stations interleave: [1, 4, 2, 5, 3, 6].
SELECT TO_BASE64(ARRAY_AGG(v)) AS tensor
FROM readings
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AACAPwAAgEAAAABAAACgQAAAQEAAAMBA

# TENSOR_AGG places by (station, sample), so the same stream yields one row per station: [[1, 2, 3], [4, 5, 6]].
SELECT TO_BASE64(TENSOR_AGG(v AT (station, sample) SHAPE (2, 3))) AS tensor
FROM readings
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AACAPwAAAEAAAEBAAACAQAAAoEAAAMBA

# Sliding windows share their one-second slices, yet every window's tensor holds exactly its own three seconds:
# [1, 2, 3, 0, 0, 0], [0, 2, 3, 4, 0, 0], ..., down to the partial windows at the end of the input.
SELECT start, end, TO_BASE64(TENSOR_AGG(v AT (i) SHAPE (6))) AS tensor
FROM timeline
WINDOW SLIDING(ts, SIZE 3000 MS, ADVANCE BY 1000 MS)
INTO windowedTensorSink;
----
0,3000,AACAPwAAAEAAAEBAAAAAAAAAAAAAAAAA
1000,4000,AAAAAAAAAEAAAEBAAACAQAAAAAAAAAAA
2000,5000,AAAAAAAAAAAAAEBAAACAQAAAoEAAAAAA
3000,6000,AAAAAAAAAAAAAAAAAACAQAAAoEAAAMBA
4000,7000,AAAAAAAAAAAAAAAAAAAAAAAAoEAAAMBA
5000,8000,AAAAAAAAAAAAAAAAAAAAAAAAAAAAAMBA

# The later timestamp wins even though it arrived first (position 0: 1); at equal timestamps the tuple later in the
# stream wins (position 1: 4): [1, 4].
SELECT TO_BASE64(TENSOR_AGG(v AT (i) SHAPE (2))) AS tensor
FROM duplicates
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AACAPwAAgEA=

# Every cell keeps its latest non-NULL value, even when the values come from different tuples and sources: x = 1 from
# the later tuple, y = 2 from the earlier one, as the later tuple's NULL y does not overwrite it: [[1, 2]].
SELECT TO_BASE64(TENSOR_AGG(x, y AT (i) SHAPE (1, 2))) AS tensor
FROM partialRows
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AACAPwAAAEA=

# SHAPE must end with the number of value fields (here 1), not 2.
SELECT TO_BASE64(TENSOR_AGG(v AT (row, col) SHAPE (2, 3, 2))) AS tensor
FROM cells
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
ERROR 2007

# Index fields must be integers.
SELECT TO_BASE64(TENSOR_AGG(v AT (v) SHAPE (3))) AS tensor
FROM cells
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
ERROR 2007

# VARSIZED rows: every row lands at its position, independent of arrival order: [[1, 2], [3, 4], [5, 6]].
SELECT TO_BASE64(TENSOR_AGG(FROM_BASE64(r) AT (i) SHAPE (3, 2))) AS tensor
FROM rowBlobs
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AACAPwAAAEAAAEBAAACAQAAAoEAAAMBA

# A row that is never written keeps the default in all of its cells: [[1, 2], [-1, -1], [5, 6]].
SELECT TO_BASE64(TENSOR_AGG(FROM_BASE64(r) AT (i) SHAPE (3, 2) DEFAULT -1)) AS tensor
FROM rowBlobs
WHERE NOT (i = UINT64(1))
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AACAPwAAAEAAAIC/AACAvwAAoEAAAMBA

# Two index axes select the row: [[[1, 2], [3, 4]], [[5, 6], [7, 8]]].
SELECT TO_BASE64(TENSOR_AGG(FROM_BASE64(r) AT (station, slot) SHAPE (2, 2, 2))) AS tensor
FROM gridBlobs
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AACAPwAAAEAAAEBAAACAQAAAoEAAAMBAAADgQAAAAEE=

# Each key's tensor combines rows from both physical sources: id 1 is [[1, 2], [3, 4]], id 2 is [[10, 20], [30, 40]].
SELECT id, TO_BASE64(TENSOR_AGG(FROM_BASE64(r) AT (i) SHAPE (2, 2))) AS tensor
FROM stationBlobs
GROUP BY id
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO keyedTensorSink;
----
1,AACAPwAAAEAAAEBAAACAQA==
2,AAAgQQAAoEEAAPBBAAAgQg==

# A whole row is replaced: the later timestamp wins even though it arrived first (position 0: [1, 2]), and at equal
# timestamps the row later in the stream wins (position 1: [5, 6]).
SELECT TO_BASE64(TENSOR_AGG(FROM_BASE64(r) AT (i) SHAPE (2, 2))) AS tensor
FROM duplicateBlobs
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
AACAPwAAAEAAAKBAAADAQA==

# A NULL row is skipped, so position 0 keeps the earlier "AAAABBBB"; position 1 stays at the default 0:
# "AAAABBBB", 8 zero bytes, "CCCCDDDD".
SELECT TO_BASE64(TENSOR_AGG(r AT (i) SHAPE (3, 2))) AS tensor
FROM textRows
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
QUFBQUJCQkIAAAAAAAAAAENDQ0NERERE

# Rows as wide as a TEAM station embedding (500 values) fill 8 * 500 * 4 bytes.
SELECT OCTET_LENGTH(TENSOR_AGG(FROM_BASE64(r) AT (i) SHAPE (8, 500))) AS bytes
FROM wideRows
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO bytesSink;
----
16000

# The wide tensor is byte for byte the one Python builds.
SELECT TO_BASE64(TENSOR_AGG(FROM_BASE64(r) AT (i) SHAPE (8, 500))) AS tensor
FROM wideRows
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
====
SELECT tensor
FROM wideTensor
INTO tensorSink;

# Every VARSIZED row must have exactly row width * 4 bytes; the rows have 8 bytes, but SHAPE asks for 3 values.
SELECT TO_BASE64(TENSOR_AGG(FROM_BASE64(r) AT (i) SHAPE (3, 3))) AS tensor
FROM rowBlobs
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
ERROR 2008

# With a VARSIZED value, SHAPE must list the row width; it cannot be left out.
SELECT TO_BASE64(TENSOR_AGG(FROM_BASE64(r) AT (i) SHAPE (3))) AS tensor
FROM rowBlobs
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
ERROR 2007

# A VARSIZED value cannot be combined with other value fields, neither numeric nor VARSIZED.
SELECT TO_BASE64(TENSOR_AGG(FROM_BASE64(r), FLOAT32(1) AT (i) SHAPE (3, 2))) AS tensor
FROM rowBlobs
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
ERROR 2007

SELECT TO_BASE64(TENSOR_AGG(FROM_BASE64(r), FROM_BASE64(r) AT (i) SHAPE (3, 2))) AS tensor
FROM rowBlobs
WINDOW TUMBLING(ts, SIZE 1000 MS)
INTO tensorSink;
----
ERROR 2007
