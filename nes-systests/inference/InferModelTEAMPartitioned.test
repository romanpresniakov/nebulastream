# sink-node stacks the embeddings by station slot and runs the head. The result equals the unpartitioned model's.
SELECT event_idx,
    mag0_alpha * mag0_mu + mag1_alpha * mag1_mu + mag2_alpha * mag2_mu + mag3_alpha * mag3_mu + mag4_alpha * mag4_mu AS magnitude,
    (loc0_alpha * loc0_lat + loc1_alpha * loc1_lat + loc2_alpha * loc2_lat + loc3_alpha * loc3_lat +
        loc4_alpha * loc4_lat + loc5_alpha * loc5_lat + loc6_alpha * loc6_lat + loc7_alpha * loc7_lat +
        loc8_alpha * loc8_lat + loc9_alpha * loc9_lat + loc10_alpha * loc10_lat + loc11_alpha * loc11_lat +
        loc12_alpha * loc12_lat + loc13_alpha * loc13_lat + loc14_alpha * loc14_lat)
        * 100.0 / 111.195 + 42.0 AS latitude,
    (loc0_alpha * loc0_lon + loc1_alpha * loc1_lon + loc2_alpha * loc2_lon + loc3_alpha * loc3_lon +
        loc4_alpha * loc4_lon + loc5_alpha * loc5_lon + loc6_alpha * loc6_lon + loc7_alpha * loc7_lon +
        loc8_alpha * loc8_lon + loc9_alpha * loc9_lon + loc10_alpha * loc10_lon + loc11_alpha * loc11_lon +
        loc12_alpha * loc12_lon + loc13_alpha * loc13_lon + loc14_alpha * loc14_lon)
        * 100.0 / 111.195 + 12.0 AS longitude,
    (loc0_alpha * loc0_depth + loc1_alpha * loc1_depth + loc2_alpha * loc2_depth + loc3_alpha * loc3_depth +
        loc4_alpha * loc4_depth + loc5_alpha * loc5_depth + loc6_alpha * loc6_depth + loc7_alpha * loc7_depth +
        loc8_alpha * loc8_depth + loc9_alpha * loc9_depth + loc10_alpha * loc10_depth + loc11_alpha * loc11_depth +
        loc12_alpha * loc12_depth + loc13_alpha * loc13_depth + loc14_alpha * loc14_depth)
        * 100.0 AS depth_km
FROM MODEL_INFERENCE(teamHead, (
    SELECT event_idx,
        TENSOR_AGG(
            e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15, e16, e17, e18, e19, e20, e21, e22,
            e23, e24, e25, e26, e27, e28, e29, e30, e31, e32, e33, e34, e35, e36, e37, e38, e39, e40, e41, e42, e43,
            e44, e45, e46, e47, e48, e49, e50, e51, e52, e53, e54, e55, e56, e57, e58, e59, e60, e61, e62, e63, e64,
            e65, e66, e67, e68, e69, e70, e71, e72, e73, e74, e75, e76, e77, e78, e79, e80, e81, e82, e83, e84, e85,
            e86, e87, e88, e89, e90, e91, e92, e93, e94, e95, e96, e97, e98, e99, e100, e101, e102, e103, e104, e105,
            e106, e107, e108, e109, e110, e111, e112, e113, e114, e115, e116, e117, e118, e119, e120, e121, e122, e123,
            e124, e125, e126, e127, e128, e129, e130, e131, e132, e133, e134, e135, e136, e137, e138, e139, e140, e141,
            e142, e143, e144, e145, e146, e147, e148, e149, e150, e151, e152, e153, e154, e155, e156, e157, e158, e159,
            e160, e161, e162, e163, e164, e165, e166, e167, e168, e169, e170, e171, e172, e173, e174, e175, e176, e177,
            e178, e179, e180, e181, e182, e183, e184, e185, e186, e187, e188, e189, e190, e191, e192, e193, e194, e195,
            e196, e197, e198, e199, e200, e201, e202, e203, e204, e205, e206, e207, e208, e209, e210, e211, e212, e213,
            e214, e215, e216, e217, e218, e219, e220, e221, e222, e223, e224, e225, e226, e227, e228, e229, e230, e231,
            e232, e233, e234, e235, e236, e237, e238, e239, e240, e241, e242, e243, e244, e245, e246, e247, e248, e249,
            e250, e251, e252, e253, e254, e255, e256, e257, e258, e259, e260, e261, e262, e263, e264, e265, e266, e267,
