# Run with:
#     systest -g FourStations --clusterConfig nes-systests/configs/topologies/four-stations.yaml
# Run with RelWithDebInfo!
# The expected embeddings come from OpenVINO on the station streams. The prediction is the one of the unpartitioned model.
# This test will be deleted as soon as partitioned operator will be implemented, since it is very messy and is only for proof of concept purposes.
# INTERPRETER only (for now, compiler fails).
GlobalConfiguration worker.query_engine.number_of_worker_threads: [1, 4]
GlobalConfiguration worker.default_query_execution.execution_mode: [INTERPRETER]

CREATE LOGICAL SOURCE station1(event_idx UINT64 NOT NULL, station_slot UINT64 NOT NULL, sample_idx UINT64 NOT NULL,
    timestamp_ms UINT64 NOT NULL, n FLOAT32 NOT NULL, e FLOAT32 NOT NULL, z FLOAT32 NOT NULL,
    latitude FLOAT32 NOT NULL, longitude FLOAT32 NOT NULL, depth_km FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR station1 TYPE File SET('station-01:8080' AS "SOURCE"."HOST");
ATTACH FILE model/team_baseline/stream_t5/IT.DUR.csv
CREATE LOGICAL SOURCE station2(event_idx UINT64 NOT NULL, station_slot UINT64 NOT NULL, sample_idx UINT64 NOT NULL,
    timestamp_ms UINT64 NOT NULL, n FLOAT32 NOT NULL, e FLOAT32 NOT NULL, z FLOAT32 NOT NULL,
    latitude FLOAT32 NOT NULL, longitude FLOAT32 NOT NULL, depth_km FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR station2 TYPE File SET('station-02:8080' AS "SOURCE"."HOST");
ATTACH FILE model/team_baseline/stream_t5/IT.LRNO.csv
CREATE LOGICAL SOURCE station3(event_idx UINT64 NOT NULL, station_slot UINT64 NOT NULL, sample_idx UINT64 NOT NULL,
    timestamp_ms UINT64 NOT NULL, n FLOAT32 NOT NULL, e FLOAT32 NOT NULL, z FLOAT32 NOT NULL,
    latitude FLOAT32 NOT NULL, longitude FLOAT32 NOT NULL, depth_km FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR station3 TYPE File SET('station-03:8080' AS "SOURCE"."HOST");
ATTACH FILE model/team_baseline/stream_t5/IT.MCLF.csv
CREATE LOGICAL SOURCE station4(event_idx UINT64 NOT NULL, station_slot UINT64 NOT NULL, sample_idx UINT64 NOT NULL,
    timestamp_ms UINT64 NOT NULL, n FLOAT32 NOT NULL, e FLOAT32 NOT NULL, z FLOAT32 NOT NULL,
    latitude FLOAT32 NOT NULL, longitude FLOAT32 NOT NULL, depth_km FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR station4 TYPE File SET('station-04:8080' AS "SOURCE"."HOST");
ATTACH FILE model/team_baseline/stream_t5/IT.PLTA.csv

